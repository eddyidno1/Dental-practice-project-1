{
  "name": "unsold-treatment-visibility",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.js",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-env.js",
    "build": "next build",
    "prestart": "node scripts/ensure-env.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/ensure-env.js && prisma migrate dev",
    "db:seed": "node scripts/ensure-env.js && tsx prisma/seed.ts",
    "db:reset": "node scripts/ensure-env.js && prisma migrate reset --force",
    "postinstall": "node scripts/ensure-env.js && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "next": "14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
