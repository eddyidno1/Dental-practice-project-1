generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Treatment {
  id           String   @id @default(cuid())
  patientName  String
  treatment    String
  value        Int
  status       String
  lastContact  DateTime
  followUpDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
